# Réglages locaux du labo. `./lab init` copie ce fichier en .env (ignoré par git) et y génère les
# mots de passe. Ne jamais commiter .env.

# Dossier des sauvegardes (`lab backup`). Les données vivantes sont dans des volumes Docker
# (disque de Docker Desktop, F:\Docker) : jamais de base MariaDB sur un dossier de Windows.
LAB_DATA_DIR=F:/Dev/glpi-test-lab-data

# Mots de passe MariaDB, communs aux instances du labo (générés par ./lab init).
LAB_DB_ROOT_PASSWORD=
LAB_DB_PASSWORD=

# Interface de GLPI après l'installation automatique (comptes glpi/glpi, tech/tech, normal/normal,
# post-only/postonly).
LAB_GLPI_LANGUAGE=fr_FR

# Plafonds mémoire par conteneur, au plus juste (valeurs mesurées : docs/memoire.md).
LAB_GLPI_MEMORY=768M
LAB_DB_MEMORY=320M
LAB_DB_BUFFER_POOL=64M

# Images épinglées (une version de GLPI par instance, dans instances.txt).
LAB_MARIADB_IMAGE=mariadb:11.8.9

# Dossier des verrous de grc-lock.sh (glpi-test-env), lu par `lab status`, `lab down` et `lab reset`.
LAB_LOCK_DIR=F:/Dev/glpi-test-env

# ---------------------------------------------------------------- briques (lot #3, profil docker)
# Mots de passe et secrets vides : générés par ./lab init (ou au premier ./lab up). Jetons d'API,
# comptes robots et empreintes htpasswd : ajoutés plus bas par les crochets (stack/<brique>/hook.sh).
# Portainer CE (http://localhost:8120) : administrateur admin, utilisateur standard glpi-lecture.
LAB_PORTAINER_ADMIN_PASSWORD=
LAB_PORTAINER_GLPI_PASSWORD=
LAB_PORTAINER_AGENT_SECRET=
# What's Up Docker 9 (http://localhost:8122) : admin et glpi-lecture (rôle ro) ; WUD 8 (:8123).
LAB_WUD_ADMIN_PASSWORD=
LAB_WUD_GLPI_PASSWORD=
LAB_WUD8_GLPI_PASSWORD=
# Harbor (http://localhost:8130) : administrateur admin ; secrets internes de ses services.
LAB_HARBOR_ADMIN_PASSWORD=
LAB_HARBOR_DB_PASSWORD=
LAB_HARBOR_REGISTRY_PASSWORD=
LAB_HARBOR_CORE_SECRET=
LAB_HARBOR_JOBSERVICE_SECRET=
LAB_HARBOR_REGISTRY_HTTP_SECRET=
LAB_HARBOR_CSRF_SECRET=
# Registre registry:2 (http://localhost:8135) : compte glpi-lecture.
LAB_REGISTRY_GLPI_PASSWORD=
LAB_REGISTRY_HTTP_SECRET=
# Forgejo (http://localhost:8140) : administrateur lab-admin, utilisateur glpi-lecture.
LAB_FORGEJO_ADMIN_PASSWORD=
LAB_FORGEJO_GLPI_PASSWORD=
# Traefik 3 et 2 (API http://localhost:8145 et :8146) : compte glpi-lecture.
LAB_TRAEFIK_GLPI_PASSWORD=
