 # .git ni vendor, dépendances de production seulement (composer --no-dev), puis réinstallation.
 # Usage : sh deploy-g12.sh [grcmanager] [configurationglpiauto] [assetsign]   (défaut : les trois)
 set -e
+# Instance du labo glpi-test-lab (G12=glpi12-a, glpi11-a...) : son conteneur Swarm se retrouve par
+# l'étiquette lab.instance. Sans G12, ou avec g12, g12b, g12c, g12d, rien ne change.
+if [ -n "${G12:-}" ] && ! docker inspect --type container "$G12" >/dev/null 2>&1; then
+  lab_c=$(docker ps -q -f "label=lab.instance=$G12" -f label=lab.role=glpi | head -1)
+  [ -n "$lab_c" ] || { echo "instance $G12 introuvable (ni conteneur, ni instance du labo en marche)" >&2; exit 1; }
+  G12=$lab_c
+fi
